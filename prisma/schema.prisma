generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  UZ
  RU
  EN
}

enum AdminRole {
  SUPER_ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
}

enum AdminAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  SESSION_REJECTED
  PROTECTED_ACCESS_DENIED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum ProductType {
  MOTORCYCLE
  PART
  ACCESSORY
  GEAR
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductCondition {
  NEW
  USED
}

enum ProductColor {
  BLACK
  WHITE
  RED
  BLUE
  GREEN
  YELLOW
  ORANGE
  GRAY
  SILVER
  BROWN
  GOLD
  MULTICOLOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  MANUAL
  CASH_ON_DELIVERY
}

enum DeliveryMethod {
  COURIER
  PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RedirectStatusCode {
  MOVED_PERMANENTLY
  PERMANENT_REDIRECT
  TEMPORARY_REDIRECT
}

model AdminUser {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  name          String
  role          AdminRole            @default(SUPER_ADMIN)
  isActive      Boolean              @default(true)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      AdminSession[]
  statusChanges OrderStatusHistory[]
  auditLogs     AdminAuditLog[]

  @@index([role, isActive])
  @@index([createdAt])
  @@index([deletedAt])
}

model AdminAuditLog {
  id             String           @id @default(cuid())
  adminUserId    String?
  action         AdminAuditAction
  outcome        AuditOutcome
  identifierHash String?
  ipHash         String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  adminUser      AdminUser?       @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([action, outcome, createdAt])
  @@index([identifierHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model AuthRateLimit {
  id              String    @id @default(cuid())
  key             String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id           String                @id @default(cuid())
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  archivedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations CategoryTranslation[]
  products     Product[]

  @@index([isActive, sortOrder])
  @@index([archivedAt])
  @@index([createdAt])
}

model CategoryTranslation {
  id             String   @id @default(cuid())
  categoryId     String
  locale         Locale
  slug           String
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale, name])
  @@index([categoryId])
}

model Brand {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  websiteUrl String?
  isActive   Boolean   @default(true)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@index([isActive, name])
  @@index([archivedAt])
  @@index([createdAt])
}

model Product {
  id              String                 @id @default(cuid())
  sku             String                 @unique
  type            ProductType
  status          ProductStatus          @default(DRAFT)
  condition       ProductCondition?
  color           ProductColor?
  categoryId      String
  brandId         String?
  price           Decimal                @db.Decimal(12, 2)
  compareAtPrice  Decimal?               @db.Decimal(12, 2)
  currency        String                 @default("UZS") @db.Char(3)
  stock           Int                    @default(0)
  isFeatured      Boolean                @default(false)
  archivedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  brand           Brand?                 @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category        Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  compatibilities ProductCompatibility[]
  images          ProductImage[]
  motorcycleSpec  MotorcycleSpec?
  orderItems      OrderItem[]
  partSpec        PartSpec?
  translations    ProductTranslation[]

  @@index([status, type, createdAt])
  @@index([status, categoryId, createdAt])
  @@index([status, brandId, createdAt])
  @@index([status, price])
  @@index([status, stock])
  @@index([status, isFeatured, createdAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([createdAt])
  @@index([archivedAt])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           Locale
  slug             String
  name             String
  shortDescription String?
  description      String
  seoTitle         String?
  seoDescription   String?
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale, name])
  @@index([productId])
}

model MotorcycleSpec {
  productId String  @id
  make      String
  model     String
  year      Int
  engineCc  Int
  mileageKm Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([make, model, year])
  @@index([year, engineCc])
}

model PartSpec {
  productId  String  @id
  partNumber String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([partNumber])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  objectKey String   @unique
  url       String
  width     Int
  height    Int
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  altUz     String
  altRu     String?
  altEn     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductCompatibility {
  id        String  @id @default(cuid())
  productId String
  make      String
  model     String
  yearFrom  Int?
  yearTo    Int?
  engineCc  Int?
  note      String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, make, model, yearFrom, yearTo, engineCc])
  @@index([productId])
  @@index([make, model, yearFrom, yearTo])
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  idempotencyKey      String?              @unique
  checkoutFingerprint String?
  status              OrderStatus          @default(PENDING)
  paymentMethod       PaymentMethod        @default(CASH)
  deliveryMethod      DeliveryMethod       @default(COURIER)
  paymentStatus       PaymentStatus        @default(PENDING)
  fulfillmentStatus   FulfillmentStatus    @default(UNFULFILLED)
  customerName        String
  phone               String
  email               String?
  region              String
  city                String
  addressLine         String
  postalCode          String?
  note                String?
  subtotal            Decimal              @db.Decimal(12, 2)
  deliveryFee         Decimal              @default(0) @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  currency            String               @default("UZS") @db.Char(3)
  stockRestoredAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([phone])
  @@index([stockRestoredAt])
  @@index([createdAt])
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  productId   String?
  productType ProductType
  name        String
  sku         String
  slug        String
  unitPrice   Decimal     @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([sku])
}

model OrderStatusHistory {
  id                    String             @id @default(cuid())
  orderId               String
  actorAdminUserId      String?
  fromStatus            OrderStatus?
  toStatus              OrderStatus
  fromPaymentStatus     PaymentStatus?
  toPaymentStatus       PaymentStatus?
  fromFulfillmentStatus FulfillmentStatus?
  toFulfillmentStatus   FulfillmentStatus?
  note                  String?
  createdAt             DateTime           @default(now())
  actorAdminUser        AdminUser?         @relation(fields: [actorAdminUserId], references: [id], onDelete: SetNull)
  order                 Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([actorAdminUserId])
  @@index([toStatus, createdAt])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String
  locale      Locale   @default(UZ)
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
  @@index([isPublic, key])
  @@index([createdAt])
}

model Redirect {
  id              String             @id @default(cuid())
  sourcePath      String             @unique
  destinationPath String
  statusCode      RedirectStatusCode @default(MOVED_PERMANENTLY)
  isActive        Boolean            @default(true)
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([isActive, sourcePath])
  @@index([expiresAt])
  @@index([createdAt])
}
