# Public application URL used for canonical links and absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string. Required when database features are enabled.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motobike_shop
# Automated tests refuse databases whose name does not end with `_test`.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motobike_shop_test
TEST_ADMIN_EMAIL=qa-admin@example.com
TEST_ADMIN_PASSWORD=Test-admin-password-2026!

# At least 32 characters. Replace for every deployed environment.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000

# Stable across all instances of the same deployment (AES-GCM key, base64).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-stable-base64-encryption-key

# Development seed only. The seed command refuses to run without both values.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=alex@#$_05

# S3-compatible object storage. Required when media uploads are enabled.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://storage.example.com
STORAGE_REGION=auto
STORAGE_BUCKET=motobike-shop
STORAGE_ACCESS_KEY_ID=replace-me
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_PUBLIC_URL=https://cdn.example.com
